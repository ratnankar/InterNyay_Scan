{
  "expo": {
    "name": "InterNyay Scan",
    "slug": "internyay-scan",
    "version": "1.0.0",
    "scheme": "internyayscan",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6F8",
    "ios": {
      "bundleIdentifier": "com.internyay.scan",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.internyay.scan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123A68"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "InterNyay Scan uses the camera to scan your legal documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "InterNyay Scan reads photos you choose to import as documents."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#123A68"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "backgroundColor": "#F4F6F8"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fb32e8e7-ac95-4c9b-80ab-f9e2a2fa86d6"
      }
    },
    "owner": "ratnankarr"
  }
}
